{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/nestjs-testing-template/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/nestjs-testing-template/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/nestjs-testing-template",
  "projects": {
    "auth-ms": {
      "type": "application",
      "root": "apps/auth-ms",
      "entryFile": "main",
      "sourceRoot": "apps/auth-ms/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-ms/tsconfig.app.json"
      }
    },
    "nestjs-testing-template": {
      "type": "application",
      "root": "apps/nestjs-testing-template",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-testing-template/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-testing-template/tsconfig.app.json"
      }
    },
    "ordering-ms": {
      "type": "application",
      "root": "apps/ordering-ms",
      "entryFile": "main",
      "sourceRoot": "apps/ordering-ms/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ordering-ms/tsconfig.app.json"
      }
    },
    "shipping-ms": {
      "type": "application",
      "root": "apps/shipping-ms",
      "entryFile": "main",
      "sourceRoot": "apps/shipping-ms/src",
      "compilerOptions": {
        "tsConfigPath": "apps/shipping-ms/tsconfig.app.json"
      }
    }
  }
}